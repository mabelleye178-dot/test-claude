  {
   "id": "hook.q",
   "scene": "hook",
   "text": "少数股权的创始人，控制力从哪里来？",
   "start": 8.873,
   "end": 11.888
  },
  {
   "id": "own.intro",
   "scene": "ownership",
   "text": "先看所有权。",
   "start": 13.15,
   "end": 14.148
  },
  {
   "id": "own.huang",
   "scene": "ownership",
   "text": "股东委托书显示，黄仁勋持有约8.7亿股，占3.58%。",
   "start": 14.498,
   "end": 19.731
  },
  {
   "id": "own.funds",
   "scene": "ownership",
   "text": "先锋领航和贝莱德，各持约7%，都比他多。",
   "start": 20.031,
   "end": 24.273
