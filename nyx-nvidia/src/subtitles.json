  },
  {
    "start": 66.9,
    "end": 70.696,
    "text": "11月12日，黄仁勋辞任，克雷斯代理CEO。",
    "scene": "timeline",
    "offsetFromScene": 18.067
  },
  {
    "start": 72.633,
    "end": 75.408,
    "text": "3.58%，从来不是控制权。",
