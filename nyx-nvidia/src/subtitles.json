    "offsetFromScene": 0.367
  },
  {
    "start": 15.333,
    "end": 19.013,
    "text": "黄仁勋持有约8.7亿股，占3.58%。",
    "scene": "ownership",
    "offsetFromScene": 2.967
  },
  {
    "start": 19.263,
    "end": 23.733,
    "text": "先锋领航7.31%，贝莱德7.43%。",
    "scene": "ownership",
    "offsetFromScene": 6.897
  },
  {
    "start": 23.983,
    "end": 26.74,
    "text": "董事与高管合计不到4%。",
    "scene": "ownership",
    "offsetFromScene": 11.617
  },
  {
    "start": 27.6,
    "end": 29.058,
    "text": "关键，在董事会。",
    "scene": "board",
    "offsetFromScene": 0.4
  },
  {
    "start": 29.6,
    "end": 33.222,
    "text": "2026年6月，股东选出10位董事，9位独立。",
    "scene": "board",
    "offsetFromScene": 2.4
  },
  {
    "start": 33.472,
    "end": 35.247,
    "text": "7月增至11席。",
    "scene": "board",
    "offsetFromScene": 6.272
  },
  {
    "start": 35.497,
    "end": 37.088,
    "text": "黄仁勋，只是一票。",
    "scene": "board",
    "offsetFromScene": 8.297
  },
  {
    "start": 38.067,
    "end": 41.109,
    "text": "英伟达只有一类普通股，没有双层股权。",
    "scene": "power",
    "offsetFromScene": 0.5
  },
  {
    "start": 41.367,
    "end": 43.979,
    "text": "股东每年选董事，董事会任免CEO。",
    "scene": "power",
    "offsetFromScene": 3.8
  },
  {
    "start": 44.367,
    "end": 46.77,
    "text": "股东还废除了绝对多数条款。",
    "scene": "power",
    "offsetFromScene": 6.8
  },
  {
    "start": 47.02,
    "end": 48.367,
    "text": "制度，大于个人。",
    "scene": "power",
    "offsetFromScene": 9.453
  },
  {
    "start": 49.5,
    "end": 52.739,
    "text": "2025年，H20出口先受限，后放行。",
    "scene": "timeline",
    "offsetFromScene": 0.667
  },
  {
    "start": 52.989,
    "end": 55.613,
    "text": "12月，H200也获准出口。",
    "scene": "timeline",
    "offsetFromScene": 4.156
  },
  {
    "start": 55.863,
    "end": 59.567,
    "text": "10月起，媒体聚焦他与客户高管的私人关系。",
    "scene": "timeline",
    "offsetFromScene": 7.03
  },
  {
    "start": 59.817,
    "end": 62.476,
    "text": "情报资产指控，尚无公开证据。",
    "scene": "timeline",
    "offsetFromScene": 10.984
  },
  {
    "start": 62.726,
    "end": 66.65,
    "text": "11月8日，他致信道歉，董事会启动独立调查。",
